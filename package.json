{
  "name": "dsh-skill-palette",
  "version": "0.1.5",
  "description": "技能助手（SkillMate）：点一下把 /技能 写进输入框，按用途分类、最近使用、收藏、一键中文翻译，回答末尾还能看到这一轮用过的 skill。Skill picker for DeepSeek Harness: browse, search, favourite and translate skills.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "skills",
    "skill-picker",
    "translate",
    "favourite",
    "技能",
    "技能助手",
    "翻译",
    "收藏"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlLHHH/dsh-skill-palette.git"
  },
  "homepage": "https://github.com/AlLHHH/dsh-skill-palette#readme",
  "bugs": {
    "url": "https://github.com/AlLHHH/dsh-skill-palette/issues"
  },
  "sideEffects": false,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
