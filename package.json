{
  "name": "dsh-skill-palette",
  "version": "0.1.0",
  "private": true,
  "description": "技能助手（SkillMate）：点一下把 /技能 写进输入框，按用途分类、最近使用、收藏置顶、一键中文翻译，还能增强回答对 skill 的使用率。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlLHHH/dsh-skill-palette"
  },
  "homepage": "https://github.com/AlLHHH/dsh-skill-palette",
  "bugs": {
    "url": "https://github.com/AlLHHH/dsh-skill-palette/issues"
  }
}
